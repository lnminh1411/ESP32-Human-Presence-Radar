# ============================================================
# ESP32 Human Presence Radar -- presence PCBs (rev 2.1)
# ============================================================
# Two boards joined by a 12-pin 0.5 mm FFC:
#   - Base (module Main, build "default"): fixed on the pan-tilt base.
#     ESP32-S3 SuperMini (2x 1x9 vertical sockets), the two SG90 servo
#     plugs, a second USB 5V input for the servos, and a PC-case piezo
#     beeper driven through a PC817.
#   - Sensor head (module Head, build "head"): rides on the two servos.
#     HLK LD2410C-P radar, SR602 PIR and VL53L1X ToF on right-angle sockets
#     at the north edge, all facing north, with the radar's 100uF + 100nF,
#     and a red indicator LED behind the PIR, driven by the firmware.
# Only the light FFC moves with the head, so the servos never pull on a
# USB cable.
#
# This file is the source of truth for the netlist. The firmware pin map is
# to be checked against it by scripts/check_pins.py once firmware exists.
#
# Power, two USB cables, both on rear panel ports, grounds shared:
#   - SuperMini USB-C (USB 3.2 Gen 1 port, 5V standby with ErP off): its
#     5V and 3V3 pins are outputs here. 5V feeds the radar and the PIR, 3V3
#     the ToF, both over the FFC.
#   - Servo input (second USB, power only, a 6-pin USB-C under the
#     SuperMini's own, both cables leaving the west edge): net servo_5v
#     feeds both servos and the beeper, with a 100uF bulk cap. It never touches v5, so
#     neither port can push current into the other, and servo and beep
#     current stays off the sensors' supply.
#
# FFC (base pin / head pin / net). A same-side (type A) cable between two
# bottom-contact connectors maps base pin k to head pin 13-k. Since rev
# 2.1 one end conductor carries the LED instead of a second GND, so a cable
# of the other type (k to k) is no longer harmless: it swaps 5V and 3V3 and
# grounds the head only through GPIO5. Check the cable with a meter first.
#    1 / 12  gnd          7 / 6   tof_xshut
#    2 / 11  v5           8 / 5   tof_int
#    3 / 10  radar_out    9 / 4   tof_sda
#    4 / 9   radar_rx    10 / 3   tof_scl
#    5 / 8   radar_tx    11 / 2   v3v3
#    6 / 7   pir_out     12 / 1   led
# The order follows the sensors west to east on the head (radar, PIR,
# ToF), so both boards route on F.Cu.
#
# Pin mapping (picked so the FFC fans straight into the SuperMini rows):
#   - Radar on UART1 through the GPIO matrix: GPIO11 = MCU RX (radar TX),
#     GPIO12 = MCU TX (radar RX), GPIO13 = radar OUT (high = presence).
#     256000 baud 8N1. Radar IO is 3.3V even on a 5V supply.
#   - PIR: GPIO10 = SR602 OUT (high = warm body moved, 3.3V push-pull).
#   - ToF on I2C: GPIO6 = SCL, GPIO7 = SDA, GPIO8 = GPIO1 (data-ready
#     interrupt, open drain), GPIO9 = XSHUT (low = sensor off). The
#     breakout carries the I2C and XSHUT pull-ups.
#   - Servos: GPIO1 = pan, GPIO2 = tilt (50 Hz LEDC, 500-2400 us).
#   - Beeper: GPIO4 drives the PC817 LED (2-4 kHz square wave = tone).
#   - Head LED: GPIO5, high = on (red LED + 270R on the head, ~5 mA).
#   - Kept free: GPIO3 (strap), GPIO43/44 (UART0, ROM boot log), GPIO19/20
#     (native USB, not on the headers), GPIO48 (onboard WS2812 + red LED).
#     No spare GPIO left on the headers.
#
# Every component declares pins as `signal <name> ~ pin <N>`, not a bare
# `pin <name>`: a named pin has no relation to a stock footprint's numbered
# pads and silently binds to nothing.

# ---- passives ----------------------------------------------------------------

component BulkCap100u:
    """100uF / 25V electrolytic, standing, 6.3 x 11 mm. On the head: the
    radar's 5V, next to its socket (the LD2410 is sensitive to supply
    ripple and sits at the end of the FFC). On the base: servo_5v, for the
    SG90 start-up spikes. Pad 1 (square) = +."""
    signal pos ~ pin 1
    signal neg ~ pin 2
    footprint = "Capacitor_THT:CP_Radial_D6.3mm_P2.50mm"

component Cap100n:
    """100nF ceramic disc (104, 50V) on the radar's 5V, for high-frequency
    supply noise."""
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    footprint = "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P5.00mm"

component Resistor:
    """Axial 1/4 W resistor, standing (2.54 mm pitch)."""
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    footprint = "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P2.54mm_Vertical"

component ResistorLying:
    """Axial 1/4 W resistor lying flat, 7.62 mm pitch: the same pitch as the
    beeper header's pins 1 and 4, so it bridges them as a rung."""
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    footprint = "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"

component ResistorSmd:
    """0805 resistor. Only the USB-C CC pull-downs: no room under the
    SuperMini for two more standing resistors."""
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    footprint = "Resistor_SMD:R_0805_2012Metric"

component Diode1N4007:
    """1N4007 across the beeper header, cathode (pin 1) to +5V, lying flat
    at 7.62 mm like the 10k. Clamps the coil kick if a magnetic buzzer is
    ever plugged in instead of the piezo."""
    signal k ~ pin 1
    signal a ~ pin 2
    footprint = "Diode_THT:D_DO-41_SOD81_P7.62mm_Horizontal"

component LedRed:
    """Red indicator LED, 2.54 mm leads (3 or 5 mm body). Pad 1 = cathode
    (flat side, short lead)."""
    signal k ~ pin 1
    signal a ~ pin 2
    footprint = "LED_THT:LED_D3.0mm"

component PC817:
    """PC817 optocoupler, DIP-4: 1 = LED anode, 2 = LED cathode, 3 =
    emitter, 4 = collector. Used as the beeper's switch (same ground on
    both sides); its 50 mA output limit sets the beep current."""
    signal anode ~ pin 1
    signal cathode ~ pin 2
    signal emitter ~ pin 3
    signal collector ~ pin 4
    footprint = "Package_DIP:DIP-4_W7.62mm"

# ---- board-to-board -------------------------------------------------------------

component Ffc12:
    """12-pin 0.5 mm FFC connector, flip-lock, bottom contact, SMD (store
    part, drawing scaled from the 20-pin size). Cable: 12-pin 0.5 mm, 101
    mm (PS4 controller power-switch ribbon), ~0.5 A per conductor. The two
    mounting tabs ("MP") carry no net."""
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6
    signal p7 ~ pin 7
    signal p8 ~ pin 8
    signal p9 ~ pin 9
    signal p10 ~ pin 10
    signal p11 ~ pin 11
    signal p12 ~ pin 12
    footprint = "PresenceRadar:FFC_P0.50mm_1x12_FlipLock_Bottom"

# ---- base: module socket and headers ---------------------------------------------

component Socket1x9:
    """One SuperMini header row, vertical. Pad 1 is the USB-C end."""
    signal pin1 ~ pin 1
    signal pin2 ~ pin 2
    signal pin3 ~ pin 3
    signal pin4 ~ pin 4
    signal pin5 ~ pin 5
    signal pin6 ~ pin 6
    signal pin7 ~ pin 7
    signal pin8 ~ pin 8
    signal pin9 ~ pin 9
    footprint = "Connector_PinSocket_2.54mm:PinSocket_1x09_P2.54mm_Vertical"

module SuperMiniSocket:
    """ESP32-S3 SuperMini, 23.5 x 18 mm, two 1x9 rows. Order from the user's
    board, USB-C end to chip end:
      side A: 5V GND 3V3 13 12 11 10 9 8
      side B: TX(43) RX(44) 1 2 3 4 5 6 7
    Row spacing measured on the user's board: 15.24 mm (0.6 in) pin centre
    to pin centre; the gap between the two plastic spacers is 12.7 mm
    (0.5 in), which agrees (15.24 - one 2.54 mm spacer width). The layout
    step places the two sockets 15.24 mm apart. The 20 castellated pads on its underside
    (GPIO14-18, 21, 33-42, 45-48) are not used."""
    a = new Socket1x9
    b = new Socket1x9

    signal vout_5v ~ a.pin1
    signal gnd     ~ a.pin2
    signal vout_3v3 ~ a.pin3
    signal gpio13  ~ a.pin4
    signal gpio12  ~ a.pin5
    signal gpio11  ~ a.pin6
    signal gpio10  ~ a.pin7
    signal gpio9   ~ a.pin8
    signal gpio8   ~ a.pin9

    signal gpio43  ~ b.pin1  # TX, UART0
    signal gpio44  ~ b.pin2  # RX, UART0
    signal gpio1   ~ b.pin3
    signal gpio2   ~ b.pin4
    signal gpio3   ~ b.pin5  # strapping pin
    signal gpio4   ~ b.pin6
    signal gpio5   ~ b.pin7
    signal gpio6   ~ b.pin8
    signal gpio7   ~ b.pin9

component ServoHeader2x3:
    """Both SG90 plugs on one 2x3 male header, one plug per 3-pin column,
    standard order: signal (orange), +5V (red, middle), GND (brown). Pan on
    pins 1-3-5, tilt on 2-4-6."""
    signal pan_sig ~ pin 1
    signal tilt_sig ~ pin 2
    signal pan_vcc ~ pin 3
    signal tilt_vcc ~ pin 4
    signal pan_gnd ~ pin 5
    signal tilt_gnd ~ pin 6
    footprint = "Connector_PinHeader_2.54mm:PinHeader_2x03_P2.54mm_Vertical"

component UsbC6P:
    """Second USB 5V for the servos and the beeper: 6-pin power-only USB-C
    receptacle (generic "Type-C 6P", 4 through-hole shell legs; stock GCT
    USB4125 footprint, same pin layout). VBUS and GND each come out on two
    pads, CC1/CC2 on the middle two. Each CC needs its own 5.1k pull-down,
    or a USB-C source (C-to-C cable) never turns VBUS on; an A-to-C cable
    gives 5V either way. The shell legs ("SH") go to GND."""
    signal vbus ~ pin A9
    signal vbus_b ~ pin B9
    signal gnd ~ pin A12
    signal gnd_b ~ pin B12
    signal cc1 ~ pin A5
    signal cc2 ~ pin B5
    signal shield ~ pin SH
    footprint = "Connector_USB:USB_C_Receptacle_GCT_USB4125-xx-x_6P_TopMnt_Horizontal"

component SpeakerHeader:
    """PC-case speaker plug, 1x4 male in the motherboard SPEAKER layout:
    pin 1 = +5V, pin 4 = driven side; the plug has wires on 1 and 4 only,
    so pins 2 and 3 stay unconnected. The user's speaker is a piezo."""
    signal vcc ~ pin 1
    signal drive ~ pin 4
    footprint = "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical"

# ---- head: sensor sockets ---------------------------------------------------------

component RadarSocket:
    """HLK LD2410C-P, 5 pins at 2.54 mm, right-angle socket. Pin order from
    Hi-Link's LD2410C manual (table 1): TX RX OUT GND VCC. The plain LD2410
    (no C) uses a different order, OUT first. VCC 5-12V, 5V advised, at
    least 200 mA available."""
    signal tx  ~ pin 1
    signal rx  ~ pin 2
    signal out ~ pin 3
    signal gnd ~ pin 4
    signal vcc ~ pin 5
    footprint = "Connector_PinSocket_2.54mm:PinSocket_1x05_P2.54mm_Horizontal"

component TofSocket:
    """VL53L1X breakout, right-angle socket. GY-style 6-pin board,
    silkscreen "VL53L0/1XV2" (VL53L1X variant). Pin order VIN GND SCL SDA
    GPIO1 XSHUT, confirmed from the store listing; still to check against
    the silkscreen on the real part."""
    signal vin   ~ pin 1
    signal gnd   ~ pin 2
    signal scl   ~ pin 3
    signal sda   ~ pin 4
    signal gpio1 ~ pin 5
    signal xshut ~ pin 6
    footprint = "Connector_PinSocket_2.54mm:PinSocket_1x06_P2.54mm_Horizontal"

component PirSocket:
    """SR602 mini PIR, 13.5 mm round board, 10 mm lens, 3 pins at 2.54 mm
    out the back. Right-angle socket like the radar and ToF (user,
    2026-11-03), so it stands facing north; a vertical socket would point
    it at the ceiling. Pin order from the store's dimension drawing, front
    view: - + OUT, so facing north OUT is west. On a right-angle socket the
    pads count up westward, hence GND = 1, OUT = 3. Supply
    3.7-12V (listing; the photo says 4.5-20V); output is 3.3V digital,
    hold 1-18 s. Ignores room-temperature motion (fan blades), so it
    vetoes radar motion that has no warm body behind it."""
    signal gnd ~ pin 1
    signal vcc ~ pin 2
    signal out ~ pin 3
    footprint = "Connector_PinSocket_2.54mm:PinSocket_1x03_P2.54mm_Horizontal"

# ---- base board ---------------------------------------------------------------

module Main:
    mcu = new SuperMiniSocket
    ffc = new Ffc12
    servos = new ServoHeader2x3
    servo_in = new UsbC6P
    r_cc1 = new ResistorSmd  # 5.1k, CC1 pull-down
    r_cc2 = new ResistorSmd  # 5.1k, CC2 pull-down
    c1 = new BulkCap100u  # servo 5V bulk
    spk = new SpeakerHeader
    opto = new PC817
    r_led = new Resistor  # 270R, opto LED
    r_spk = new Resistor  # 33R, beeper series
    r_dis = new ResistorLying  # 10k, piezo discharge
    d1 = new Diode1N4007

    # ---- named nets ----
    # Without these, atopile names each net after a random member pin.
    signal gnd
    signal v5         # SuperMini 5V pin -> FFC -> radar, PIR
    signal v3v3       # SuperMini 3V3 pin -> FFC -> ToF
    signal servo_5v   # second USB, servos + beeper
    signal radar_tx   # radar TX -> MCU RX
    signal radar_rx   # MCU TX -> radar RX
    signal radar_out
    signal pir_out
    signal tof_scl
    signal tof_sda
    signal tof_int
    signal tof_xshut
    signal servo_pan
    signal servo_tilt
    signal led        # GPIO5 -> FFC -> head LED
    signal beep       # GPIO4 -> 270R
    signal beep_led   # 270R -> opto LED
    signal spk_drive  # speaker pin 4
    signal opto_c     # opto collector -> 33R
    gnd ~ mcu.gnd
    v5 ~ mcu.vout_5v
    v3v3 ~ mcu.vout_3v3
    servo_5v ~ servo_in.vbus
    radar_tx ~ mcu.gpio11
    radar_rx ~ mcu.gpio12
    radar_out ~ mcu.gpio13
    pir_out ~ mcu.gpio10
    tof_scl ~ mcu.gpio6
    tof_sda ~ mcu.gpio7
    tof_int ~ mcu.gpio8
    tof_xshut ~ mcu.gpio9
    servo_pan ~ mcu.gpio1
    servo_tilt ~ mcu.gpio2
    led ~ mcu.gpio5
    beep ~ mcu.gpio4
    beep_led ~ opto.anode
    spk_drive ~ spk.drive
    opto_c ~ opto.collector

    # ---- FFC to the head (head pin = 13 - base pin) ----
    gnd ~ ffc.p1
    v5 ~ ffc.p2
    radar_out ~ ffc.p3
    radar_rx ~ ffc.p4
    radar_tx ~ ffc.p5
    pir_out ~ ffc.p6
    tof_xshut ~ ffc.p7
    tof_int ~ ffc.p8
    tof_sda ~ ffc.p9
    tof_scl ~ ffc.p10
    v3v3 ~ ffc.p11
    led ~ ffc.p12

    # ---- power: USB 2 (servos, beeper) ----
    gnd ~ servo_in.gnd
    gnd ~ servo_in.gnd_b
    gnd ~ servo_in.shield
    servo_5v ~ servo_in.vbus_b
    servo_in.cc1 ~ r_cc1.p1
    r_cc1.p2 ~ gnd
    servo_in.cc2 ~ r_cc2.p1
    r_cc2.p2 ~ gnd
    servo_5v ~ c1.pos
    gnd ~ c1.neg
    servo_5v ~ servos.pan_vcc
    servo_5v ~ servos.tilt_vcc
    gnd ~ servos.pan_gnd
    gnd ~ servos.tilt_gnd

    # ---- servos ----
    servo_pan ~ servos.pan_sig
    servo_tilt ~ servos.tilt_sig

    # ---- beeper: GPIO4 -> 270R -> PC817 LED; collector -> 33R -> speaker ----
    # LED current (3.3 - 1.2) / 270 = ~8 mA. The 10k across the speaker lets
    # the piezo discharge between pulses; the 1N4007 clamps a coil's kick.
    beep ~ r_led.p1
    r_led.p2 ~ opto.anode
    opto.cathode ~ gnd
    opto.emitter ~ gnd
    opto.collector ~ r_spk.p1
    r_spk.p2 ~ spk.drive
    servo_5v ~ spk.vcc
    servo_5v ~ r_dis.p1
    r_dis.p2 ~ spk.drive
    servo_5v ~ d1.k
    d1.a ~ spk.drive

# ---- sensor head board ------------------------------------------------------------

module Head:
    radar = new RadarSocket
    tof = new TofSocket
    pir = new PirSocket
    ffc = new Ffc12
    c1 = new BulkCap100u  # radar 5V bulk
    c2 = new Cap100n      # radar 5V HF
    led1 = new LedRed     # behind the PIR
    r_led = new Resistor  # 270R, LED series

    signal gnd
    signal v5
    signal v3v3
    signal radar_tx
    signal radar_rx
    signal radar_out
    signal pir_out
    signal tof_scl
    signal tof_sda
    signal tof_int
    signal tof_xshut
    signal led        # from GPIO5
    signal led_a      # 270R -> LED anode

    # ---- FFC from the base (head pin = 13 - base pin) ----
    gnd ~ ffc.p12
    v5 ~ ffc.p11
    radar_out ~ ffc.p10
    radar_rx ~ ffc.p9
    radar_tx ~ ffc.p8
    pir_out ~ ffc.p7
    tof_xshut ~ ffc.p6
    tof_int ~ ffc.p5
    tof_sda ~ ffc.p4
    tof_scl ~ ffc.p3
    v3v3 ~ ffc.p2
    led ~ ffc.p1

    # ---- LED: GPIO5 -> 270R -> red LED -> GND, (3.3 - 1.9) / 270 = ~5 mA ----
    led ~ r_led.p1
    r_led.p2 ~ led_a
    led_a ~ led1.a
    led1.k ~ gnd

    # ---- radar ----
    v5 ~ radar.vcc
    gnd ~ radar.gnd
    radar_tx ~ radar.tx
    radar_rx ~ radar.rx
    radar_out ~ radar.out
    v5 ~ c1.pos
    gnd ~ c1.neg
    v5 ~ c2.p1
    gnd ~ c2.p2

    # ---- PIR ----
    v5 ~ pir.vcc
    gnd ~ pir.gnd
    pir_out ~ pir.out

    # ---- ToF ----
    v3v3 ~ tof.vin
    gnd ~ tof.gnd
    tof_scl ~ tof.scl
    tof_sda ~ tof.sda
    tof_int ~ tof.gpio1
    tof_xshut ~ tof.xshut
